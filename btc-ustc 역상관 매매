import tkinter as tk
from tkinter import messagebox, scrolledtext
import ccxt
import threading
import time
import requests

class BithumbInverseTrader:
    def __init__(self, root):
        self.root = root
        self.root.title("Bithumb USDC-BTC 역상관 매매 (환율 조건)")
        self.root.geometry("500x700")
        
        self.is_running = False
        self.exchange = None

        # --- GUI 레이아웃 ---
        # 1. API 설정
        tk.Label(root, text="[1] 빗썸 API 설정", font=('Arial', 10, 'bold')).pack(pady=5)
        
        tk.Label(root, text="API Key:").pack()
        self.ent_api = tk.Entry(root, width=45)
        self.ent_api.pack()

        tk.Label(root, text="Secret Key:").pack()
        self.ent_secret = tk.Entry(root, width=45, show="*")
        self.ent_secret.pack()

        # 2. 매매 조건 설정
        tk.Label(root, text="\n[2] 매매 및 환율 조건", font=('Arial', 10, 'bold')).pack(pady=5)

        # 환율 임계치
        tk.Label(root, text="작동 최소 환율 (원/달러) - 예: 1400").pack()
        self.ent_rate_threshold = tk.Entry(root)
        self.ent_rate_threshold.insert(0, "1400")
        self.ent_rate_threshold.pack()

        # 목표가 설정 (USDC/BTC 가격)
        tk.Label(root, text="매도 목표가 (USDC 고점/BTC 저점 시 - USDC를 BTC로 교체)").pack()
        self.ent_sell_target = tk.Entry(root)
        self.ent_sell_target.insert(0, "0.00001420")
        self.ent_sell_target.pack()

        tk.Label(root, text="매수 목표가 (BTC 고점/USDC 저점 시 - BTC를 USDC로 교체)").pack()
        self.ent_buy_target = tk.Entry(root)
        self.ent_buy_target.insert(0, "0.00001380")
        self.ent_buy_target.pack()

        tk.Label(root, text="1회 거래 수량 (USDC 기준)").pack()
        self.ent_amount = tk.Entry(root)
        self.ent_amount.insert(0, "10")
        self.ent_amount.pack()

        # 3. 로그 출력 및 버튼
        self.log_area = scrolledtext.ScrolledText(root, height=15, width=60)
        self.log_area.pack(pady=15)

        self.btn_start = tk.Button(root, text="자동매매 시작", command=self.start_trading, bg="#4CAF50", fg="white", width=20)
        self.btn_start.pack(pady=5)

        self.btn_stop = tk.Button(root, text="중지", command=self.stop_trading, state="disabled", bg="#f44336", fg="white", width=20)
        self.btn_stop.pack()

    def log(self, message):
        curr_time = time.strftime('%Y-%m-%d %H:%M:%S')
        self.log_area.insert(tk.END, f"[{curr_time}] {message}\n")
        self.log_area.see(tk.END)

    def get_krw_usd_rate(self):
        """실시간 원/달러 환율 가져오기 (무료 API)"""
        try:
            url = "https://api.exchangerate-api.com/v4/latest/USD"
            response = requests.get(url)
            data = response.json()
            return data['rates']['KRW']
        except Exception as e:
            self.log(f"환율 API 호출 오류: {e}")
            return None

    def start_trading(self):
        api_key = self.ent_api.get().strip()
        secret = self.ent_secret.get().strip()
        
        if not api_key or not secret:
            messagebox.showerror("오류", "API 키와 시크릿을 모두 입력해 주세요.")
            return

        self.exchange = ccxt.bithumb({
            'apiKey': api_key,
            'secret': secret,
            'enableRateLimit': True,
        })

        self.is_running = True
        self.btn_start.config(state="disabled")
        self.btn_stop.config(state="normal")
        
        self.trade_thread = threading.Thread(target=self.trade_loop, daemon=True)
        self.trade_thread.start()
        self.log(">>> 시스템 가동 시작")

    def stop_trading(self):
        self.is_running = False
        self.btn_start.config(state="normal")
        self.btn_stop.config(state="disabled")
        self.log(">>> 시스템 정지 중...")

    def trade_loop(self):
        symbol = 'USDC/BTC'
        while self.is_running:
            try:
                # 1. 환율 체크
                current_rate = self.get_krw_usd_rate()
                threshold = float(self.ent_rate_threshold.get())

                if current_rate is None:
                    self.log("환율 정보를 가져올 수 없어 다음 루프로 넘어갑니다.")
                    time.sleep(60)
                    continue

                self.log(f"현재 환율: {current_rate}원 (설정값: {threshold}원)")

                if current_rate < threshold:
                    self.log(f"환율이 낮아 대기 중... (현재 {current_rate} < 목표 {threshold})")
                    time.sleep(60)
                    continue

                # 2. 빗썸 시세 조회 (USDC/BTC)
                ticker = self.exchange.fetch_ticker(symbol)
                usdc_price_in_btc = ticker['last']
                self.log(f"현재 USDC 가격: {usdc_price_in_btc:.8f} BTC")

                sell_target = float(self.ent_sell_target.get())
                buy_target = float(self.ent_buy_target.get())
                amount = float(self.ent_amount.get())

                # 3. 매매 로직 (역상관)
                # USDC가 BTC 대비 비쌀 때 (USDC 고점) -> USDC 매도하여 BTC 확보
                if usdc_price_in_btc >= sell_target:
                    self.log(f"!! 조건 일치 (고점): {usdc_price_in_btc} >= {sell_target}")
                    order = self.exchange.create_market_sell_order(symbol, amount)
                    self.log(f"결과: {amount} USDC 매도(BTC 매수) 완료")
                
                # USDC가 BTC 대비 쌀 때 (BTC 고점) -> BTC를 매도하여 USDC 확보
                elif usdc_price_in_btc <= buy_target:
                    self.log(f"!! 조건 일치 (저점): {usdc_price_in_btc} <= {buy_target}")
                    order = self.exchange.create_market_buy_order(symbol, amount)
                    self.log(f"결과: {amount} USDC 매수(BTC 매도) 완료")

            except Exception as e:
                self.log(f"실행 중 오류: {e}")
            
            # 30초 간격으로 모니터링
            time.sleep(30)

if __name__ == "__main__":
    root = tk.Tk()
    app = BithumbInverseTrader(root)
    root.mainloop()
